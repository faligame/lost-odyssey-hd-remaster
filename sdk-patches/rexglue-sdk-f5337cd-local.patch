+void XmaContext::StoreContextMerged(const XMA_CONTEXT_DATA& data,
+                                    const XMA_CONTEXT_DATA& initial_data, uint8_t* context_ptr) {
+  uint32_t nuevo[sizeof(XMA_CONTEXT_DATA) / 4];
+  uint32_t inicial[sizeof(XMA_CONTEXT_DATA) / 4];
+  std::memcpy(nuevo, &data, sizeof(nuevo));
+  std::memcpy(inicial, &initial_data, sizeof(inicial));
+
+  for (int palabra : {0, 1, 2, 4, 9}) {
+    std::atomic_ref<uint32_t> destino(reinterpret_cast<uint32_t*>(context_ptr)[palabra]);
+    uint32_t actual_be = destino.load(std::memory_order_acquire);
+    for (;;) {
+      const uint32_t actual = SwapWord(actual_be);
+      uint32_t resultado = actual;
+      for (const CampoXma& campo : kCamposDelDecodificador) {
+        if (campo.palabra != palabra) {
+          continue;
+        }
+        const uint32_t de_inicio = inicial[palabra] & campo.mascara;
+        const uint32_t del_decodificador = nuevo[palabra] & campo.mascara;
+        const uint32_t del_juego = actual & campo.mascara;
+        if (del_decodificador == de_inicio) {
+          continue;  // el decodificador no lo toco
+        }
+        if (campo.solo_borrar) {
+          // Solo se borra el bit si el decodificador lo consumio y sigue puesto.
+          if (de_inicio != 0 && del_decodificador == 0) {
+            resultado &= ~campo.mascara;
+          }
+        } else if (del_juego == de_inicio) {
+          // El juego no lo cambio mientras se decodificaba: gana el decodificador.
+          resultado = (resultado & ~campo.mascara) | del_decodificador;
+        }
+        // Si el juego lo cambio (reinicio el stream, avanzo su cursor...), gana el juego.
+      }
+      if (resultado == actual) {
+        break;
+      }
+      if (destino.compare_exchange_weak(actual_be, SwapWord(resultado), std::memory_order_acq_rel,
+                                        std::memory_order_acquire)) {
+        break;
+      }
+      // El juego escribio esa palabra justo ahora: repetir con su valor nuevo.
+    }
   }
