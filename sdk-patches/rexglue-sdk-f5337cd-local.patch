+namespace {
+
+// FUGA ARREGLADA (27-sep-2026). XThread::Exit() y Terminate() se quedaban con
+// una referencia al objeto (`auto self = retain_object(this)`) para que
+// ReleaseHandle() no lo borrase mientras la funcion seguia viva... pero
+// justo despues llaman a Thread::Exit(), QUE NO VUELVE: el destructor de `self`
+// no se ejecutaba nunca y cada hilo que terminaba dejaba para siempre su
+// objeto, su X_KTHREAD, su PCR, su TLS y su scratch. Con este juego, que crea
+// ~20 hilos por segundo, eso agota en minutos los 256 MB de la ventana de
+// sistema y el siguiente ExCreateThread falla (el juego no lo comprueba y se
+// cierra).
+//
+// Arreglo: en vez de soltar la referencia ahi (peligroso: borraria el objeto
+// desde dentro de si mismo), se aparca en esta lista con la hora, y la barre
+// otro hilo pasados un par de segundos, cuando el hilo que murio ya no existe.
+struct HiloMuerto {
+  object_ref<XThread> hilo;
+  std::chrono::steady_clock::time_point momento;
+};
+
+std::mutex g_muertos_mutex;
+
+// A proposito con `new` y sin destructor: si la lista se destruyese al terminar
+// el proceso soltaria referencias DESPUES de que el kernel ya no exista, y
+// ~XThread (que llama a UnregisterThread) reventaria al salir.
+std::vector<HiloMuerto>* Muertos() {
+  static auto* lista = new std::vector<HiloMuerto>();
+  return lista;
+}
+
+constexpr auto kEsperaAntesDeBorrar = std::chrono::seconds(2);
+
+void BarrerHilosMuertos() {
+  // Las referencias se sueltan FUERA del mutex: soltarlas puede ejecutar
+  // ~XThread, que toca el kernel y podria volver a entrar aqui.
+  std::vector<object_ref<XThread>> sueltos;
+  {
+    std::lock_guard<std::mutex> lock(g_muertos_mutex);
+    auto* lista = Muertos();
+    const auto ahora = std::chrono::steady_clock::now();
+    for (size_t i = 0; i < lista->size();) {
+      if (ahora - (*lista)[i].momento >= kEsperaAntesDeBorrar) {
+        sueltos.push_back(std::move((*lista)[i].hilo));
+        lista->erase(lista->begin() + i);
+      } else {
+        ++i;
+      }
+    }
+  }
+}
+
+void EnterrarHilo(object_ref<XThread> hilo) {
+  BarrerHilosMuertos();
+  std::lock_guard<std::mutex> lock(g_muertos_mutex);
+  Muertos()->push_back(HiloMuerto{std::move(hilo), std::chrono::steady_clock::now()});
+}
