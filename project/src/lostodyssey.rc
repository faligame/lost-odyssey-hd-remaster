// lostodyssey - icono de la aplicacion (project/icon.ico) y datos de version
#include <windows.h>
#include "lo_version.h"

IDI_ICON1 ICON "../icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LO_VERSION_MAJOR, LO_VERSION_MINOR, LO_VERSION_PATCH, 0
 PRODUCTVERSION LO_VERSION_MAJOR, LO_VERSION_MINOR, LO_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Proyecto no oficial"
            VALUE "FileDescription", "Lost Odyssey HD Remaster"
            VALUE "FileVersion", LO_VERSION_STRING
            VALUE "InternalName", "lostodyssey"
            VALUE "OriginalFilename", "lostodyssey.exe"
            VALUE "ProductName", "Lost Odyssey HD Remaster"
            VALUE "ProductVersion", LO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
